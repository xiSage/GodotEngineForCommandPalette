<?xml version="1.0" encoding="utf-8"?>
<!--
  Publish profile for the single-project MSIX packaging / Visual Studio "Deploy" flow.
  Visual Studio and the Windows App SDK packaging targets resolve
  Properties\PublishProfiles\win-$(Platform).pubxml through the PublishProfile property
  in GodotEngineForCommandPalette.csproj. Without this file the build reports
  NETSDK1198 and Visual Studio cannot deploy the extension as a package.

  Modelled on the official Command Palette extension template
  (src/modules/cmdpal/ExtensionTemplate/TemplateCmdPalExtension/Properties/PublishProfiles/win-x64.pubxml).

  SelfContained is pinned for Release: this profile is what supplies the RuntimeIdentifier, and
  Release enables PublishTrimmed, which ILLink only supports for self-contained apps - without the
  pair the build fails with NETSDK1102.

  PublishSingleFile is pinned off, as the official template does. The single-project MSIX packaging
  targets build the payload (the Visual Studio "Deploy" layout and tools/pack-store.ps1) from this
  project's PackagingOutputs, and a single-file build drops the project's own assemblies from that
  list: the package then ships the apphost without GodotEngineForCommandPalette.dll,
  GodotEngineForCommandPalette.runtimeconfig.json, GodotConfigFile.dll and GodotResourceUID.dll, so
  the COM server dies with "The application to execute does not exist:
  ...\GodotEngineForCommandPalette.dll" and the extension never shows up in Command Palette.
  Reproduce with `dotnet msbuild GodotEngineForCommandPalette.csproj -t:GetPackagingOutputs
  -getItem:PackagingOutputs -p:Configuration=Release -p:Platform=x64 -p:RuntimeIdentifier=win-x64`:
  the app assemblies are missing while PublishSingleFile is true and present once it is false.
  A single file can still be produced deliberately with -p:PublishSingleFile=true on the command
  line, which overrides this profile.
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained Condition="'$(Configuration)' == 'Release'">true</SelfContained>
    <PublishDir>bin\$(Platform)\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\publish\</PublishDir>
  </PropertyGroup>
</Project>
